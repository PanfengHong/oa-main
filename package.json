    "@my-oa/designer": "file:../oa-designer",
    "@my-oa/meeting": "file:../oa-meeting",
    "@my-oa/project": "file:../oa-project",
    "@my-oa/chat": "file:../oa-chat",
    "@my-oa/task": "file:../oa-task",
    "antd": "^5.26.0",
    "dayjs": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
