{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@my-oa/form": ["../oa-form/src/index.ts"],
      "@my-oa/flow": ["../oa-flow/src/index.ts"],
      "@my-oa/designer": ["../oa-designer/src/index.ts"],
      "@my-oa/meeting": ["../oa-meeting/src/index.ts"],
      "@my-oa/task": ["../oa-task/src/index.ts"],
      "@my-oa/project": ["../oa-project/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
